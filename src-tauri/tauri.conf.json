{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "health-mention",
  "version": "0.1.0",
  "identifier": "com.cococodedede.health-mention",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "health-mention",
        "width": 420,
        "height": 600,
        "resizable": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "休息一下",
        "url": "overlay.html",
        "width": 380,
        "height": 150,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
